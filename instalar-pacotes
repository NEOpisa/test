#!/usr/bin/env bash
# Instala/atualiza a DE com os pacotes prontos, do projeto ou do arquivo portátil.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
[[ $EUID -ne 0 ]] || { echo 'Execute como usuário normal.' >&2; exit 1; }
case "${1:-}" in
  --help|-h)
    printf '%s\n' './instalar-pacotes            instala ou atualiza o Birfree deste projeto' \
      './instalar-pacotes --mostrar  mostra os pacotes sem instalar' \
      'Não recompila. Rode como usuário normal; o pacman pede sudo e confirmação.'
    exit 0 ;;
  ''|--mostrar) ;;
  *) printf 'Opção desconhecida: %s\n' "$1" >&2; exit 1 ;;
esac
pacotes=()
if [[ -d "$ROOT/pacotes" ]]; then
  [[ -f "$ROOT/SHA256SUMS" ]] || { printf 'Falta SHA256SUMS no arquivo extraído.\n' >&2; exit 1; }
  ( cd "$ROOT" && sha256sum --check --status SHA256SUMS ) \
    || { printf 'A verificação dos arquivos falhou. Extraia novamente ou transfira outra cópia.\n' >&2; exit 1; }
  for nome in birfree-icons birfree birfree-terminal; do
    arquivos=("$ROOT/pacotes/$nome"-[0-9]*.pkg.tar.zst)
    [[ ${#arquivos[@]} -eq 1 && -f "${arquivos[0]}" ]] \
      || { printf 'Esperava um pacote de %s no arquivo extraído.\n' "$nome" >&2; exit 1; }
    pacotes+=("${arquivos[0]}")
  done
else
  [[ -f "$ROOT/scripts/indexed-packages.py" ]] || {
    echo 'Baixe e extraia o arquivo .tar.gz completo da Release; faltam os pacotes.' >&2
    exit 1
  }
  selecionados="$(python3 "$ROOT/scripts/indexed-packages.py" "$ROOT/vendor/repo" birfree-icons birfree birfree-terminal)"
  while IFS= read -r arquivo; do
    [[ -f "$arquivo" ]] && pacotes+=("$arquivo")
  done <<< "$selecionados"
fi
if [[ ${#pacotes[@]} -ne 3 ]]; then
  printf '%s\n' 'Faltam os pacotes. Gere-os com ./neo/packaging/build-birfree.sh' >&2
  exit 1
fi
printf '\nBirfree — atualizar a área de trabalho\n\n'
command -v pacman >/dev/null \
  || { printf 'Este instalador requer Arch Linux ou sistema compatível com pacman.\n' >&2; exit 1; }
for arquivo in "${pacotes[@]}"; do
  pacman -Qp "$arquivo"
done
[[ "${1:-}" != --mostrar ]] || exit 0
# Plugins C++ precisam da mesma ABI de KWin/Qt usada na compilação.
INCLUIR='Include = /etc/pacman.d/birfree-congelar.conf'
pilha_ok() {
  local nome esperado atual
  for nome in kwin qt6-base; do
    esperado=$(sed -n "s/^installed = $nome-\(.*\)-x86_64$/\1/p" "$ROOT/VERSOES.txt" | head -n1)
    atual=$(pacman -Q "$nome" 2>/dev/null | cut -d ' ' -f2) || true
    [[ -n "$esperado" && "$atual" == "$esperado" ]] || {
      printf 'Pilha: %s instalado=%s; compilado=%s.\n' "$nome" "${atual:-ausente}" "${esperado:-desconhecido}"
      return 1
    }
  done
}
if [[ -f "$ROOT/VERSOES.txt" ]] && ! pilha_ok; then
  # O KDE/Qt fica congelado no -Syu; este Birfree foi compilado contra outro.
  # Atualiza o sistema inteiro uma vez sem o congelamento e confere de novo.
  printf '\nEste Birfree foi compilado contra outro KDE/Qt. O pacman vai atualizar o\nsistema inteiro uma vez, sem o congelamento, e pedir confirmação.\n'
  semgelo=$(mktemp "${TMPDIR:-/tmp}/birfree-pacman.XXXXXX.conf")
  trap 'rm -f "$semgelo"' EXIT
  grep -vxF "$INCLUIR" /etc/pacman.conf > "$semgelo"
  sudo pacman --config "$semgelo" -Syu
  pilha_ok || {
    printf 'O KDE/Qt dos repositórios não é o deste Birfree. Nada do Birfree foi instalado;\naguarde o próximo teste.\n' >&2
    exit 1
  }
fi
printf '\nO pacman vai mostrar a transação e pedir confirmação.\n'
sudo pacman -U --overwrite usr/share/wayland-sessions/birfree.desktop "${pacotes[@]}"
# Congela o KDE/Qt no -Syu (uma linha na seção [options] do pacman.conf)
if ! grep -qxF "$INCLUIR" /etc/pacman.conf; then
  sudo sed -i "/^\[options\]/a $INCLUIR" /etc/pacman.conf
  printf '\nO pacman -Syu agora não atualiza o KDE nem o Qt (ver /etc/pacman.d/birfree-congelar.conf).\n'
fi
printf '\nAtualização concluída. Salve seu trabalho, saia da sessão e entre novamente em Birfree.\n'
