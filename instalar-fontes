#!/usr/bin/env bash
# Compila os fontes da Release no computador que executa o instalador.
# Nenhum pacote binário de outra máquina é usado neste fluxo.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
case "${1:-}" in
  -h|--help)
    printf '%s\n' './instalar-fontes            compila e instala o Birfree neste computador' \
      './instalar-fontes --mostrar  confere os fontes sem compilar ou instalar'
    exit 0 ;;
  ''|--mostrar) ;;
  *) printf 'Opção desconhecida: %s\n' "$1" >&2; exit 1 ;;
esac
[[ $EUID -ne 0 ]] || { echo 'Execute como usuário normal; sudo será pedido apenas para o pacman.' >&2; exit 1; }
arquivo="$ROOT/fontes/Birfree-fontes.tar.gz"
[[ -f "$ROOT/SHA256SUMS" && -f "$arquivo" ]] || {
  echo 'Faltam os fontes da Release. Baixe o arquivo completo do teste 6.' >&2; exit 1;
}
( cd "$ROOT" && sha256sum --check --status SHA256SUMS ) || {
  echo 'A verificação dos arquivos falhou. Baixe novamente a Release.' >&2; exit 1;
}
tar -tzf "$arquivo" >/dev/null
[[ ! -f "$ROOT/VERSOES.txt" ]] || cat "$ROOT/VERSOES.txt"
printf '\nEste instalador compila os fontes neste computador antes de instalar.\n'
[[ "${1:-}" != --mostrar ]] || exit 0
[[ $(uname -m) == x86_64 ]] || { echo 'Este teste requer x86_64.' >&2; exit 1; }
command -v pacman >/dev/null || { echo 'Este instalador requer Arch Linux ou compatível com pacman.' >&2; exit 1; }
for comando in sudo python3; do
  command -v "$comando" >/dev/null || { printf 'Falta o comando: %s\n' "$comando" >&2; exit 1; }
done

# O atualizador limpa o download temporário ao sair. Os fontes e logs ficam
# no cache do usuário para diagnóstico ou retomada de uma compilação falha.
cache="${XDG_CACHE_HOME:-$HOME/.cache}/birfree/compilacoes"
mkdir -p "$cache"
trabalho=$(mktemp -d "$cache/test6.XXXXXXXX")
python3 - "$arquivo" "$trabalho" <<'PY'
import sys, tarfile
with tarfile.open(sys.argv[1], 'r:gz') as archive:
    archive.extractall(sys.argv[2], filter='data')
PY
fonte="$trabalho/Birfree-fontes"
for caminho in instalar.sh pacote/PKGBUILD birfree-icons/pacote/PKGBUILD; do
  [[ -f "$fonte/$caminho" ]] || { printf 'Fonte incompleto: %s\n' "$caminho" >&2; exit 1; }
done

# Lê as dependências das mesmas receitas que serão compiladas. birfree-icons
# é gerado localmente e entra junto com birfree na transação final.
mapfile -t dependencias < <(
  for receita in "$fonte/birfree-icons/pacote/PKGBUILD" "$fonte/pacote/PKGBUILD"; do
    ( export BIRFREE_PACKAGE_BASE=atual; source "$receita"
      printf '%s\n' "${depends[@]}" "${makedepends[@]}" )
  done | sort -u
)
oficiais=(base-devel)
for dependencia in "${dependencias[@]}"; do
  [[ $dependencia == birfree-icons ]] || oficiais+=("$dependencia")
done
printf '\nFontes e logs: %s\n' "$trabalho"
printf 'O pacman pedirá confirmação para instalar as dependências de compilação.\n'
sudo pacman -S --needed -- "${oficiais[@]}"
export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-2}"
export MAKEFLAGS="${MAKEFLAGS:--j2}"
printf '\nCompilando neste computador. Log: %s/compilacao.log\n' "$trabalho"
if ! bash "$fonte/instalar.sh" --base-atual --gerar-pacotes 2>&1 | tee "$trabalho/compilacao.log"; then
  printf 'A compilação falhou; o Birfree instalado foi preservado. Consulte %s/compilacao.log\n' "$trabalho" >&2
  exit 1
fi
pacotes=()
for pasta in birfree-icons/pacote pacote; do
  lista=$(cd "$fonte/$pasta" && makepkg --packagelist)
  encontrados=()
  while IFS= read -r pacote; do
    [[ $pacote == *-debug-* ]] && continue
    [[ -f $pacote ]] && encontrados+=("$pacote")
  done <<< "$lista"
  [[ ${#encontrados[@]} -eq 1 ]] || { printf 'Esperava um pacote gerado em %s.\n' "$pasta" >&2; exit 1; }
  pacotes+=("${encontrados[0]}")
done
printf '\nO pacman vai mostrar os dois pacotes locais e pedir confirmação.\n'
sudo pacman -U --overwrite usr/share/wayland-sessions/birfree.desktop -- "${pacotes[@]}"
printf '\nInstalação concluída. Salve seu trabalho, saia e entre novamente em Birfree.\n'
